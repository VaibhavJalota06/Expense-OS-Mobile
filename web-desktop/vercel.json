{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/service-worker.js$",
      "headers": {
        "Service-Worker-Allowed": "/",
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/service-worker.js"
    },
    {
      "src": "^/manifest.json$",
      "headers": {
        "Content-Type": "application/manifest+json"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "^/app(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^/dashboard(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^/auth-callback(/.*)?$",
      "dest": "/auth-callback.html"
    },
    {
      "src": "^/landing(/.*)?$",
      "dest": "/landing/index.html"
    },
    {
      "src": "^/$",
      "dest": "/landing/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
